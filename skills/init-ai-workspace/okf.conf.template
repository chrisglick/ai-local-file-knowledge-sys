# Knowledge-system settings for this project.
# Written by /init-ai-workspace. Safe to edit by hand. Commit this file.

# ---------------------------------------------------------------------------
# archive — what /end-session keeps of each conversation.
#
# When you and Claude decide something, the reason lives in the conversation.
# A note saying "we chose Postgres" is only trustworthy if you can go back and
# read WHY. So /end-session can save the conversation into this repo and have
# your notes point at it.
#
# The catch: a conversation contains whatever was said in it. Client names,
# unreleased plans, personal details, a password someone pasted in. Saving it
# is useful. PUBLISHING it usually isn't. These modes are that choice.
#
#   local   Save the conversation to ai/session/raw/, never commit it.
#           It stays on this computer. Other people who clone this repo won't
#           get it, so your notes' sources won't open for them.
#           <-- DEFAULT. Right for almost everyone, and always right if unsure.
#
#   shared  Save it AND commit it, so teammates (and anyone who can read this
#           repo) get it too. Only for PRIVATE repos, and only if you accept
#           that everything said in the session ships with the code.
#           NEVER use this on a public repo.
#
#   off     Don't save conversations at all. Safest. The cost: a decision's
#           "why" has no source anyone can open, so `okf --check` will flag
#           those notes. Choose this if the work is confidential.
#
# Not sure? Leave it as `local`. You can change it any time; it only affects
# sessions from that point on.
# ---------------------------------------------------------------------------
archive = local

# ---------------------------------------------------------------------------
# Two things this setting does NOT do, so you aren't surprised:
#
# 1. The raw .jsonl transcript is NEVER committed, in any mode. It contains the
#    output of every command Claude ran — which can include environment
#    variables, file contents, and API keys printed by ordinary tools. The
#    tooling refuses to write it anywhere that isn't gitignored.
#
# 2. The secret scan is not a safety net. It finds keys with a recognisable
#    shape (ghp_..., sk-ant-..., AKIA...). It CANNOT find passwords, database
#    connection strings, personal data, or internal hostnames — those look like
#    ordinary text. "0 hits" means "nothing obvious", never "safe to publish".
#
# If a secret ever does get committed: deleting the file is not enough. Git
# keeps it in history, and anyone who cloned or forked already has it. Rotate
# the credential — that is the only real fix.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# govern-work settings — only read if you've installed the govern-work skill.
# Uncomment and fill in the ones you need; every line here has a safe absence
# (govern-work refuses loudly, and tells you which line to add, rather than
# guessing).
#
#   govern_verify_command
#       The ONE command that proves this project's work is correct — the
#       same thing you'd run by hand after a change to know it's still good.
#       `gov mint` refuses to start any contract without this set: without a
#       verify command, the system can certify "the checklist was followed"
#       but never "the work is actually right." For code, this is usually
#       your test command. Example:
#         govern_verify_command = python -m pytest -q
#
#   govern_verify_trivially_true
#       Set this to `true` ONLY for a project with no automated check at all
#       (a pure docs or research repo). It tells govern-work "there is
#       genuinely nothing to run" instead of leaving the verify command
#       blank and hoping nobody notices. It prints a loud one-time banner
#       and is recorded on every contract, so nobody mistakes silence for a
#       real check. The ledger gate (a completion report with a `##
#       Decisions` section) and the deny-list still apply either way —
#       this setting only ever affects whether CORRECTNESS is checked.
#         govern_verify_trivially_true = true
#
#   govern_base_branch
#       Which branch a new contract worktree is built from. Most repos never
#       need this — it defaults to `main`. Set it if your default branch is
#       named something else.
#         govern_base_branch = main
#
#   govern_worktree_dir
#       Where contract worktrees are created. Defaults to a sibling folder
#       next to this repo (`../<repo>-contracts`) so they never clutter the
#       repo itself. Change this only if that default collides with
#       something on your machine.
#         govern_worktree_dir = ../my-project-contracts
#
#   govern_ratchet_baseline
#       Where `gov --ratchet` / `gov --baseline` keep their committed count
#       file. Defaults to `ai/govern-baseline.json`. You'll rarely need to
#       change this; it's here so the ratchet's own record can move without
#       editing code.
#         govern_ratchet_baseline = ai/govern-baseline.json
#
#   govern_ratchet_grep_<name>
#       An extra count for `gov --ratchet` to track, beyond the built-in
#       "unverified notes" count. Each one is a name you pick plus a regex —
#       the ratchet refuses to let its match count rise. Useful for tracking
#       your own "known debt" markers over time.
#         govern_ratchet_grep_todos = TODO\(unowned\)
# ---------------------------------------------------------------------------
