#!/bin/sh
# govern-work enforcement-path deny-list guard for the git `pre-commit` hook.
#
# Ported nearly as-is from an earlier project's contract-runner enforcement hook. This copy
# restates the doctrine inline (R15: shipped docs must be corpus-free self-contained) rather
# than pointing at a source path that would only resolve on the machine that produced it.
#
# INSTALLATION (the `gov mint` contract-runner wave installs this): copy this file to
# `.git/hooks/pre-commit` in the contract's worktree checkout. `.git/hooks/` is UNVERSIONED
# git-internal state, shared by every worktree that points at the same git dir, and lives
# OUTSIDE the tracked working tree -- nothing a `git add` / `git commit` does can ever reach
# it. This file is itself the versioned source of truth and lives once, in the govern-work
# SKILL directory (not vendored per project, per R1) -- a contracted agent scoped to a single
# project checkout has no repo-native path to either copy. That is the concrete answer to
# "where does the deny-list's own definition live where the agent cannot edit it": the
# hardcoded core list below is installed outside the tracked tree, and its source lives
# outside the project repo entirely.
#
# WHY A DENY LIST AND NOT A WHITELIST (R3/R4, restated so this file is self-contained):
# An earlier version of this kind of system gave each unit of work an explicit list of files
# it was allowed to touch, and refused anything outside it. In practice this made the work
# WORSE, not safer: an agent that needed to touch a file outside its list would contort the
# change to fit inside the list instead -- the god-object problem with a tool enforcing it.
# The fix was recognizing the isolated worktree is already the boundary that matters. What
# survives is a short, EXACT-match deny list of the instruments that judge the work (this
# hook, the gov/okf shims, the ratchet baseline): an agent who can edit the referee that will
# judge it is not enforced. That has nothing to do with file-overlap, so it did not go with
# the whitelist. The list below is deliberately exact-match paths only, NEVER a glob or
# prefix, so it can never quietly widen back into the whitelist that was retired.
#
# CONTRACT-WORKTREE DETECTION: a MARKER FILE IN TMPDIR, never a file inside the repo. A
# checkout under contract has a marker at
#   ${TMPDIR:-${TMP:-${TEMP:-/tmp}}}/govern-work/contract-<sanitized-toplevel-path>.deny
# written by `gov mint` at contract start and removed by `land`/`abort`. Its PRESENCE is the
# signal that this worktree is under contract -- not a branch-name pattern, which decouples
# enforcement from whatever branch convention the contract runner ends up using, and keeps
# the signal entirely outside the tracked working tree so no staged or committed change can
# spoof or erase it. Its CONTENTS (optional) are additional, contract-specific deny paths --
# one per line, `#`-comments allowed -- ADDED to, never able to REMOVE, the hardcoded core
# list below.
#
# Outside a contract worktree (no marker for this toplevel) this hook is INERT. A shared git
# hook fires in EVERY linked worktree of a repo; Krishna runs a dozen-plus worktrees at once,
# and a hook that disturbs peers breaks unrelated work.
#
# HONESTY NOTE (R8): this guard is ADVISORY-STRENGTH, not airtight. A contracted agent has
# code execution and can bypass it (`git commit --no-verify`, direct index writes, editing the
# TMPDIR marker itself, editing this installed hook file, editing .git/hooks directly). It
# raises the floor from "briefing discipline" to "mechanical default"; airtight would need
# sandboxing, which is out of scope. A refusal below always names the fix.

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# ---- contract-worktree detection: marker file in TMPDIR, never in the repo ----
tmpbase="${TMPDIR:-${TMP:-${TEMP:-/tmp}}}"
sanitized=$(printf '%s' "$top" | sed 's/[^A-Za-z0-9]/_/g')
marker="$tmpbase/govern-work/contract-$sanitized.deny"
[ -f "$marker" ] || exit 0   # not a contract worktree -> nothing to guard, stay silent

staged=$(git diff --cached --name-only)
[ -n "$staged" ] || exit 0   # nothing staged (e.g. a merge commit) -> allow

# ---- the deny list ----
# Core enforcement paths (R4). Hardcoded here -- not read from any file inside the repo -- so
# a contract cannot widen or shrink it by editing anything in the working tree. Exact-match
# strings only; see the doctrine note above for why this must never become a glob.
core_deny="ai/scripts/gov
ai/scripts/okf"

# The ratchet baseline path is configurable (govern_ratchet_baseline in ai/okf.conf); read it
# the same flat `key = value` way the rest of this system's config is read, falling back to
# the documented default when unset. A missing/unreadable ai/okf.conf is not an error here --
# same fail-safe posture the archive-mode default uses.
baseline="ai/govern-baseline.json"
if [ -f "$top/ai/okf.conf" ]; then
  cfg_baseline=$(sed -n 's/^[[:space:]]*govern_ratchet_baseline[[:space:]]*=[[:space:]]*\([^#]*\).*/\1/p' "$top/ai/okf.conf" | head -n1 | sed 's/[[:space:]]*$//')
  [ -n "$cfg_baseline" ] && baseline="$cfg_baseline"
fi

extra_deny=""
if [ -s "$marker" ]; then
  extra_deny=$(grep -v '^[[:space:]]*#' "$marker" | grep -v '^[[:space:]]*$')
fi

deny_list="$core_deny
$baseline
$extra_deny"

# Marker for "something was blocked" lives in TMPDIR too, and ONLY for the duration of this
# hook run -- both while-loops below are piped subshells (POSIX sh scoping), so a plain shell
# variable set inside them would not survive to the check after. A real file does. An
# interrupted hook must never leave this behind and spuriously refuse the NEXT commit, so it
# is created fresh and removed on every exit path.
hit=$(mktemp 2>/dev/null) || hit="$tmpbase/govern-work-hit-$$"
rm -f "$hit"

echo "$staged" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  echo "$deny_list" | while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ "$f" = "$d" ]; then
      echo "pre-commit: BLOCKED $f -- ENFORCEMENT path, denied by govern-work" >&2
      : > "$hit"
      break
    fi
  done
done

if [ -f "$hit" ]; then
  rm -f "$hit"
  echo "pre-commit: commit REFUSED -- staged set touches an ENFORCEMENT path." >&2
  echo "            deny list: ai/scripts/gov, ai/scripts/okf, ratchet baseline ($baseline)," >&2
  echo "            plus any contract-specific entries in the marker at:" >&2
  echo "            $marker" >&2
  echo "            Fix: unstage the enforcement path -- 'git restore --staged <path>' -- and" >&2
  echo "            make your change elsewhere. The blacklist must not be able to protect" >&2
  echo "            itself: editing an enforcement path needs an explicit re-mint with" >&2
  echo "            --allow-enforcement-edit and the human's loud, recorded go (R4)." >&2
  echo "            (advisory guard; --no-verify bypasses it -- do that only with a stated reason)" >&2
  exit 1
fi
rm -f "$hit"
exit 0
